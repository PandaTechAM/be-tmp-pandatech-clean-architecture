<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Hangfire"/>
    <PackageReference Include="MassTransit.RabbitMQ"/>
    <PackageReference Include="Pandatech.CommissionCalculator"/>
    <PackageReference Include="Pandatech.Communicator"/>
    <PackageReference Include="Pandatech.MassTransit.PostgresOutbox"/>
    <PackageReference Include="Pandatech.SharedKernel"/>
    <PackageReference Include="Pandatech.SharedKernel.Postgres"/>
  </ItemGroup>

  <!-- Transitive-dependency pins (not used directly here; anchored at the root project so they
       flow to every project that references Core, including the test project). -->
  <ItemGroup>
    <!-- EF skew: Microsoft.EntityFrameworkCore.Tools (PrivateAssets=all, in Infrastructure) raises
         EF Core to 10.0.9 there, but Core/Application/Api floor at 10.0.5 via the Pandatech packages.
         The projects that reference the 10.0.9-compiled Infrastructure assembly then hit an assembly
         version conflict (MSB3277). Pin EF Core explicitly so the whole graph unifies to 10.0.9. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    <!-- TEMPORARY: overrides the vulnerable Microsoft.OpenApi 2.0.0 (NU1903 / GHSA-v5pm-xwqc-g5wc)
         pulled in transitively via Pandatech.SharedKernel. 2.10.0 is the latest patched 2.x (3.x is a
         different major the stack doesn't target). Delete this explicit pin once the upstream chain
         resolves a patched Microsoft.OpenApi on its own. Do NOT let IDE "remove redundant reference"
         cleanup strip it while the transitive is still 2.0.0. -->
    <PackageReference Include="Microsoft.OpenApi"/>
  </ItemGroup>

</Project>
